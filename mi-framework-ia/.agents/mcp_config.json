            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "C:\\Users\\oscar\\Documents\\UNIVERSIDAD\\8.OCTAVO SEMESTRE\\electiva_IA\\mi-framework-ia"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git",
                "--repository",
                "C:\\Users\\oscar\\Documents\\UNIVERSIDAD\\8.OCTAVO SEMESTRE\\electiva_IA\\mi-framework-ia"
            ]
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "context7": {
            "url": "https://mcp.context7.com/mcp"
        },
        "mem0": {
            "url": "https://mcp.mem0.ai/mcp",
