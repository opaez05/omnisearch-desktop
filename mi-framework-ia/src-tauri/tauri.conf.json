{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSearch Desktop",
  "version": "0.4.2",
  "identifier": "com.miframework.semanticexplorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniSearch Desktop — Explorador Semántico Local",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      },
      {
        "label": "tray-popup",
        "title": "OmniSearch Quick Tray",
        "url": "index.html?window=tray",
        "width": 360,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' blob: data:; object-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
